# --- Afscherming (coming soon) -------------------------------------------------
# Alle HTML-pagina's van de klantensite lopen via gate.php: zonder toegangskoekje
# ziet men /binnenkort/. De personeelsapps (eigen codes) en bestanden blijven vrij.
# Bij de lancering: dit blok weghalen.
DirectoryIndex index.html
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteRule ^(keuken|koerier|eigenaar|partner|beheer|resto|widget|img|binnenkort|aanmelden|video|kennismaking|m)(/|$) - [L]
RewriteRule ^gate\.php$ - [L]
RewriteCond %{REQUEST_URI} (^/$|/$|\.html$)
RewriteRule ^ /gate.php [L,QSA]
RewriteCond %{QUERY_STRING} (^|&)toegang=
RewriteRule ^ /gate.php [L,QSA]
# --- einde afscherming ------------------------------------------------------------
